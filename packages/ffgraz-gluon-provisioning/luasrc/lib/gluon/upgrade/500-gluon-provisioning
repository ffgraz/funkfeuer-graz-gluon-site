#!/usr/bin/lua

-- Setup a cron for gluon-provisioning if enabled

local uci = require('simple-uci').cursor()

local urandom = io.open('/dev/urandom', 'r')
local seed1, seed2 = urandom:read(2):byte(1, 2)
math.randomseed(seed1*0x100 + seed2)
urandom:close()

-- Provision at a random time each hour
local minute = math.random(0, 59)

-- leftover from when this package was called manman-sync
os.remove('/usr/lib/micron.d/manman-sync')

local f = io.open('/usr/lib/micron.d/gluon-provisioning', 'w')
-- Only setup cron if enabled
-- Write file regardless to clear old cron
if uci:get_bool('gluon-provisioning', 'provisioning', 'enabled') then
  f:write(string.format('%i * * * * /usr/bin/gluon-provisioning provision\n', minute))
end
f:close()
