#!/usr/bin/lua

local uci = require('simple-uci').cursor()
local ip = require 'luci.ip' -- luci-lib-ip
local site = require 'gluon.site'
local json = require 'luci.jsonc'
local util = require 'gluon.util'
local sysconfig = require 'gluon.sysconfig'
local extranets = require 'gluon.extranets'
local pretty_hostname = require 'pretty_hostname'

-- GLUON_PROVISIONING_API points the node at a single server instead of the
-- site's, so a test (or a hand-run against a local server) needs no rebuild
local api = os.getenv('GLUON_PROVISIONING_API')
api = api and { api } or site.provisioning.api()

-- CLI lib from olsrd-cli (TODO: move to it's own lib package)
-- DO NOT EDIT HERE, JUST COPY FROM THERE

local function printf(...)
	print(string.format(...))
end

-- Print contents of `tbl`, with indentation.
-- `indent` sets the initial level of indentation.
-- src https://gist.github.com/xytis/5361405
local function tprint (tbl, indent)
	if not indent then indent = 0 end
	for k, v in pairs(tbl) do
		local formatting = string.rep('  ', indent) .. k .. ': '

		if type(v) == 'table' then
			print(formatting)
			tprint(v, indent + 1)
		else
			print(formatting .. tostring(v))
		end
	end
end

-- src https://stackoverflow.com/a/24823383/3990041
function table.slice(tbl, first, last, step)
	local sliced = {}

	for i = first or 1, last or #tbl, step or 1 do
		sliced[#sliced+1] = tbl[i]
	end

	return sliced
end

-- CLI lib

local function exec_cmd(args, sub)
	if sub[args[1]] == nil then
		return cmd_err('does not exist')
	else
		local cmd = sub[args[1]]
		if cmd[3] ~= nil and #args > 1 then
			exec_cmd(table.slice(args, 2), cmd[3])
		else
			os.exit(cmd[1](unpack(table.slice(args, 2))) or 0)
		end
	end
end

local function list_cmd(level, sub)
	for key, cmd in pairs(sub) do
		printf('%s%s: %s', string.rep('  ', level), key, cmd[2])
		if cmd[3] ~= nil then
			list_cmd(level + 1, cmd[3])
		end
	end
end

local function show_help()
	printf('Usage: %s <command>', arg[0])
	list_cmd(1, sub)
end

local function cmd_err(msg, no_show_help)
	-- since argv0 is at... well... 0... even though this is lua...
	--- ...slice just returns arg without argv0 as the for starts at 1
	printf('Error: Command "%s" %s', table.concat(table.slice(arg), ' '), msg)
	if not no_show_help then
		printf('')
		show_help()
	end
	os.exit(2)
end

-- ///

-- https://gist.github.com/Uradamus/10323382
local function shuffle(tbl)
	for i = #tbl, 2, -1 do
		local j = math.random(i)
		tbl[i], tbl[j] = tbl[j], tbl[i]
	end

	return tbl
end

local function shellquote(str)
	return "'" .. (tostring(str):gsub("'", "'\\''")) .. "'"
end

-- POST body to url with the token as bearer auth, return the decoded JSON body.
-- uclient-fetch is used instead of a lua http client so that this package does
-- not pull in one - it is part of the base system.
local function post_json(url, token, body)
	local out = os.tmpname()

	local ok = os.execute(table.concat({
		'uclient-fetch', '-q', '--timeout=20',
		'-O', shellquote(out),
		'--post-data=' .. shellquote(body),
		'--header=' .. shellquote('Content-Type: application/json'),
		'--header=' .. shellquote('Authorization: Bearer ' .. token),
		shellquote(url),
	}, ' ')) == 0

	local f = io.open(out)
	local raw = f and f:read('*a') or ''
	if f then f:close() end
	os.remove(out)

	if not ok then
		return nil, 'request failed'
	end

	local resp = json.parse(raw)
	if type(resp) ~= 'table' then
		return nil, 'response is not JSON: ' .. raw:sub(1, 200)
	end

	return resp
end

-- What this hardware is, so the server can record it instead of the
-- placeholder a node is created with. From ubus rather than from
-- /tmp/sysinfo, because board_name is what names the vendor.
local function board()
	local out = os.tmpname()

	local ok = os.execute('ubus call system board > ' .. shellquote(out)
		.. ' 2>/dev/null') == 0

	local f = io.open(out)
	local raw = f and f:read('*a') or ''
	if f then f:close() end
	os.remove(out)

	local info = ok and json.parse(raw) or nil
	if type(info) ~= 'table' then
		print('W: could not ask ubus what this board is')
		return nil, nil
	end

	return info.model, info.board_name
end

--[[
	This node's own certificate fingerprint, if it has one.

	The config-mode proxy pins to it, so reporting it is what lets the proxy
	tell this node from something answering in its place. The helper belongs to
	ffgraz-config-mode-remote, so a node without that package simply reports
	nothing and the field is absent.
]]
local function tls_fingerprint()
	local pipe = io.popen('gluon-config-mode-remote-fingerprint 2>/dev/null')

	if not pipe then
		return nil
	end

	local out = pipe:read('*l')
	pipe:close()

	return out and out:match('^%x+$') and out or nil
end

--[[
	The transit networks to the devices bridging this node to another one.

	A link is named by the uci section it lives in and by the device the link
	role was given to - both stable, unlike the positional lnk<n> name that
	only means anything inside one run of extranets.links().
]]
local function requested_links()
	local links = {}

	for _, link in ipairs(extranets.links()) do
		table.insert(links, {
			section = link.section,
			device = link.device,
			current = link.cidr,
		})
	end

	return links
end

--[[
	The extra networks this hardware actually has ports for.

	A node with no interface in the exposed role has nothing to put an exposed
	range on, and asking for one would take a /29 out of the pool for nothing.
]]
local function requested_networks()
	local names = {}

	for _, network in ipairs(extranets.NETWORKS) do
		if #util.get_role_interfaces(uci, network.role) > 0 then
			table.insert(names, network.name)
		end
	end

	return names
end

local function do_provision()
	local token = uci:get('gluon-provisioning', 'provisioning', 'token')

	if not token or token == '' then
		print('E: no provisioning token configured')
		return 2
	end

	local model, board_name = board()

	local body = json.stringify({
		primary_mac = sysconfig.primary_mac,
		node_id = util.node_id(),
		model = model,
		board_name = board_name,
		tls_fingerprint = tls_fingerprint(),
		networks = requested_networks(),
		links = requested_links(),
	})

	local resp, err
	for _, remote in ipairs(shuffle(api)) do
		if not resp then
			local url = remote .. '/provision'
			print('POST ' .. url)

			resp, err = post_json(url, token, body)
			if not resp then
				print('E: ' .. remote .. ': ' .. err)
			end
		end
	end

	if not resp then
		print('E: could not reach any provisioning server, giving up')
		return 1
	end

	if not resp.ok then
		print('E: provisioning rejected: ' .. (resp.error or 'no reason given'))
		return 2
	end

	if type(resp.loopback) ~= 'table' then
		print('E: response carries no loopback addresses')
		return 1
	end

	uci:set('gluon-provisioning', 'provisioning', 'location_name', resp.location_name)
	uci:set('gluon-provisioning', 'provisioning', 'node_name', resp.node_name)

	-- a node without a name of its own is just called after its location
	local should_hostname = resp.location_name
	if resp.location_name and resp.node_name then
		should_hostname = resp.location_name .. '-' .. resp.node_name
	elseif resp.node_name then
		should_hostname = resp.node_name
	end

	if should_hostname and should_hostname ~= pretty_hostname.get(uci) then
		print('Renaming node to ' .. should_hostname)
		pretty_hostname.set(uci, should_hostname)
		uci:save('system')
	end

	local has_changes = false

	-- Use this when changing something that needs a reload (not the hostname)
	local function set(a, b, c, d, isbool)
		local curval

		if isbool then
			curval = uci:get_bool(a, b, c)
		else
			curval = uci:get(a, b, c)
		end

		if curval ~= d then
			uci:set(a, b, c, d)
			print('  Value', a, b, c, 'changed to', tostring(d), 'was', tostring(curval))
			has_changes = true
		else
			print('  Value', a, b, c, 'unchanged', tostring(d))
		end
	end

	if resp.contact then
		local owner = uci:get_first('gluon-node-info', 'owner')
		uci:set('gluon-node-info', owner, 'contact', resp.contact)
	end

	if resp.latitude and resp.longitude then
		local location = uci:get_first('gluon-node-info', 'location')
		uci:set('gluon-node-info', location, 'share_location', '1')
		uci:set('gluon-node-info', location, 'latitude', resp.latitude)
		uci:set('gluon-node-info', location, 'longitude', resp.longitude)
	end

	-- The server says whether the node should tunnel only when it has been
	-- configured to have an opinion; with the field absent the mesh VPN is
	-- left exactly as the operator set it.
	if type(resp.mesh_vpn) == 'boolean' then
		print('Syncing mesh vpn: ' .. (resp.mesh_vpn and 'on' or 'off'))
		set('gluon', 'mesh_vpn', 'enabled', resp.mesh_vpn, true)
	end

	--[[
		The node's own addresses. Both are host addresses: 310-static-ip puts
		them on loopback as /32 and /128, so a prefix here would describe the
		server's pool rather than this node and is dropped.
	]]
	for option, family in pairs({ ip4 = 4, ip6 = 6 }) do
		local got = resp.loopback[option]

		if got == nil then
			printf('  loopback: %s not provisioned', option)
		else
			local addr = ip.new(got)

			if not addr or (family == 6) ~= addr:is6() then
				printf('E: loopback: %s is not an IPv%i address', tostring(got), family)
			else
				set('gluon-static-ip', 'loopback', option, addr:host():string())
			end
		end
	end

	--[[
		The extra networks. The server hands out the range and the node takes
		its first address, the same way it does on a link - so what counts as
		"the node's address in it" is decided in one place.
	]]
	local networks = type(resp.networks) == 'table' and resp.networks or {}

	for name, provisioned in pairs(networks) do
		for key, option in pairs({ prefix4 = 'ipaddr', prefix6 = 'ip6addr' }) do
			local range = type(provisioned) == 'table' and provisioned[key]
			local family = key == 'prefix4' and 4 or 6
			local addr = range and ip.new(range)

			if range and (not addr or (family == 6) ~= addr:is6() or not addr:prefix()) then
				printf('E: %s: %s is not an IPv%i range', name, tostring(range), family)
			elseif range then
				set('network', name, option,
					addr:minhost():string() .. '/' .. addr:prefix())
			end
		end
	end

	--[[
		The key the config-mode proxy's capabilities are signed with.

		Provisioned rather than baked into the firmware so it can be rotated
		without a rebuild - a node picks up a new one on its next run.
	]]
	if type(resp.config_access) == 'table' and resp.config_access.pubkey then
		set('gluon-config-mode-remote', 'remote', 'pubkey', resp.config_access.pubkey)
	end

	--[[
		The links. Only the range is set here: 115-gluon-linknets builds the
		interface out of it, and the far end is given the second address by
		whoever configures the device on it.
	]]
	local links = type(resp.links) == 'table' and resp.links or {}

	for section, provisioned in pairs(links) do
		local linknet = type(provisioned) == 'table' and provisioned.linknet or nil

		if linknet ~= nil and not extranets.linknet(linknet) then
			printf('E: %s: %s is not a /30', section, tostring(linknet))
		else
			set('gluon', section, 'linknet', linknet)
		end
	end

	uci:save('gluon')
	uci:save('gluon-static-ip')
	uci:save('gluon-provisioning')
	uci:save('gluon-node-info')
	uci:save('gluon-config-mode-remote')
	uci:save('network')
	os.execute('exec uci commit')

	if has_changes then
		print('Applying changes...')
		os.execute('exec gluon-reconfigure')
		os.execute('exec gluon-reload')
	else
		print('No settings changes, no reason to reload')
	end

	return 0
end

local function maybe_provision()
	if uci:get_bool('gluon-provisioning', 'provisioning', 'enabled') then
		return do_provision()
	end

	print('gluon-provisioning not enabled, skipping')
end

local function enable_provisioning(token)
	if not uci:get('gluon-provisioning', 'provisioning', 'token') and not token then
		cmd_err('requires a token (no token was found in config)', true)
	end

	if token then
		print('Config token')
		uci:set('gluon-provisioning', 'provisioning', 'token', token)
	end

	if not uci:get_bool('gluon-provisioning', 'provisioning', 'enabled') then
		uci:set('gluon-provisioning', 'provisioning', 'enabled', true)
		print('Enabled provisioning.')
		print('Trigger with: $ gluon-provisioning provision')
	else
		print('Provisioning already enabled.')
	end

	uci:save('gluon-provisioning')
end

local function disable_provisioning()
	if uci:get_bool('gluon-provisioning', 'provisioning', 'enabled') then
		uci:set('gluon-provisioning', 'provisioning', 'enabled', false)
		print('Disabled provisioning.')
		uci:save('gluon-provisioning')
	end
end

local function show_info()
	local token = uci:get('gluon-provisioning', 'provisioning', 'token')

	tprint({
		enabled = uci:get_bool('gluon-provisioning', 'provisioning', 'enabled'),
		token = token and (token:sub(1, 4) .. '...') or '[none]',
		location_name = uci:get('gluon-provisioning', 'provisioning', 'location_name') or '[unknown]',
		node_name = uci:get('gluon-provisioning', 'provisioning', 'node_name') or '[unknown]',
		primary_mac = sysconfig.primary_mac,
		node_id = util.node_id(),
	})
end

sub = {
	info = { show_info, 'Show gluon-provisioning configuration.' },
	help = { show_help, 'Show help.' },
	provision = { maybe_provision, 'Trigger provisioning.' },
	force_provision = { do_provision, 'Trigger provisioning, despite being disabled.' },
	enable = { enable_provisioning, 'Enable provisioning. [<token>]' },
	disable = { disable_provisioning, 'Disable provisioning.' }
}

exec_cmd(table.slice(arg), sub)
