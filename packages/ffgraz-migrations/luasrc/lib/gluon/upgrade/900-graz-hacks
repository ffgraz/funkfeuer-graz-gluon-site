#!/usr/bin/lua

local uci = require('simple-uci').cursor()

-- use ff dns, and let dnsmasq listen everywhere again

-- Reverts the earlier { 'private', 'exposed' } binding: dnsmasq binds to what
-- is listed here and nothing else, so every network left out kept its
-- generated dhcp-range and still got no DHCP and no DNS. Without the option
-- it listens on all of them.
uci:delete('dhcp', uci:get_first('dhcp', 'dnsmasq'), 'interface')

-- The DNS server handed to clients has to be the option payload: the
-- three argument form of set() would set the section type instead,
-- leaving 500-ddhcpd-option-nextnode's payload of the next-node
-- address in place, which no node answers on.
--
-- Only where ddhcpd is installed at all: it is out of the image for now,
-- and writing its config would leave one behind for a package that is
-- not there.
if uci:get_first('ddhcpd', 'ddhcpd') then
	uci:set('ddhcpd', 'nextnode_dns', 'payload', '10.12.0.10')
	uci:save('ddhcpd')
end

uci:save('dhcp')
